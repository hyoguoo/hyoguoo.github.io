---
import { getCollection } from 'astro:content';
import PageLayout from '../components/PageLayout.astro';
import ContentPreview from '../components/ContentPreview.astro';
import { SITE_PROFILE } from '../data/siteProfile';
import { contentUrl, newestFirst, updatedDate, isDocsArticle } from '../lib/content';
const posts = (await getCollection('docs', ({ id, data }) => id.startsWith('blog/') && !data.draft)).sort(newestFirst).slice(0, 3);
const docs = (await getCollection('docs', ({ id, data }) => isDocsArticle(id) && !data.draft && Boolean(data.date))).sort(newestFirst).slice(0, 4);
---
<PageLayout title="hyoguoo.log" description={SITE_PROFILE.description} activePage="home" sitemap={true}>
  <main class="container home-page">
    <section class="profile-intro" aria-label="소개">
      <div><p class="profile-role">{SITE_PROFILE.role}</p><h1>{SITE_PROFILE.name}</h1><p class="profile-description">{SITE_PROFILE.description}</p></div>
      <img class="profile-avatar" src="/images/about-profile.png" alt="오구" width="80" height="80" />
    </section>
    <div class="home-columns">
      <section aria-labelledby="home-blog"><div class="section-heading"><h2 id="home-blog">Blog</h2><a href="/blog/">전체 보기 →</a></div>
        {posts.map(post => <ContentPreview editorial title={post.data.title} href={contentUrl(post.id)} description={post.data.description} date={updatedDate(post.data)} category={post.data.tags?.[0]} />)}
      </section>
      <section class="home-docs" aria-labelledby="home-docs"><div class="section-heading"><h2 id="home-docs">Docs</h2><a href="/docs/">전체 보기 →</a></div>
        {docs.map(doc => <ContentPreview compact title={doc.data.title} href={contentUrl(doc.id)} description={doc.data.description} date={updatedDate(doc.data)} category={doc.data.tags?.[0]} categoryHref={`/docs/${doc.id.split('/')[1]}/`} />)}
      </section>
    </div>
  </main>
</PageLayout>
<style>
  .home-columns { display: grid; grid-template-columns: minmax(0,1.75fr) minmax(0,1fr); gap: 2.5rem; align-items: start; margin-top: 1rem; }
  .home-columns > section { min-width: 0; }
  .home-columns > section:first-child :global(.content-preview:first-of-type .preview-title) { font-size: 1.4rem; font-weight: 690; line-height: 1.45; }
  .home-columns > section:first-child > .section-heading { border-bottom: 0; padding-bottom: 0; }
  .home-docs { background: var(--color-surface); border-radius: .65rem; padding: 1.3rem 1.5rem .3rem; }
  .home-docs .section-heading { border-bottom: 0; padding-bottom: 0; }
  @media (max-width: 55rem) { .home-columns { gap: 1.75rem; grid-template-columns: minmax(0,1.5fr) minmax(0,1fr); } .home-docs { padding-inline: 1.15rem; } }
  @media (max-width: 40rem) { .home-columns { grid-template-columns: 1fr; gap: 1.75rem; } .home-columns > section:first-child :global(.content-preview:first-of-type .preview-title) { font-size: 1.25rem; } }
</style>
