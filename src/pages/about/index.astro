---
import PageLayout from '../../components/PageLayout.astro';
import { SITE_PROFILE } from '../../data/siteProfile';
---
<PageLayout title="About · hyoguoo" description={`${SITE_PROFILE.name} · ${SITE_PROFILE.role}`} activePage="about">
  <main class="container about-page">
    <section class="profile-intro about-profile" aria-label="소개">
      <div><p class="profile-role">{SITE_PROFILE.role}</p><h1>{SITE_PROFILE.name}</h1><p class="profile-description">{SITE_PROFILE.description}</p><p class="profile-tagline">And also a big fan of Platypus Ogu 🦆</p>
        <nav class="profile-links" aria-label="연락처"><a href="https://github.com/hyoguoo" target="_blank" rel="noopener">GitHub ↗</a><a href="https://www.linkedin.com/in/hyoguoo" target="_blank" rel="noopener">LinkedIn ↗</a><a href="mailto:hyoguoo@gmail.com">Email</a></nav>
      </div>
      <img class="profile-avatar" src="/images/about-profile.png" alt="Platypus Ogu" width="150" height="150" />
    </section>
    <section class="about-section"><h2>Skills</h2><ul class="skills">{['Java', 'Spring Boot', 'JPA', 'Querydsl', 'TypeScript', 'MySQL', 'Redis', 'JUnit'].map(skill => <li>{skill}</li>)}</ul></section>
    <section class="about-section" id="stats-section"><h2>Stats</h2><div class="stats-grid">
      <div class="stats-item"><a href="https://github.com/hyoguoo" target="_blank" rel="noopener"><img src="https://streak-stats.demolab.com?user=hyoguoo&theme=dark&hide_border=true&background=1e293b&ring=3b82f6&fire=3b82f6&currStreakLabel=94a3b8&sideLabels=94a3b8&dates=94a3b8&currStreakNum=e2e8f0&sideNums=e2e8f0" alt="GitHub Streak Stats" width="495" height="195" /></a></div>
      <div class="stats-item"><a href="https://solved.ac/profile/hyoguoo" target="_blank" rel="noopener"><img src="https://mazassumnida.wtf/api/v2/generate_badge?boj=hyoguoo" alt="Solved.ac Badge" width="350" height="170" /></a></div>
    </div></section>
    <section class="about-section records"><h2>기록</h2><div class="record-links">
      <a href="/about/study-log/" class="site-link record-link"><span><span class="site-link-title">Study Log</span><span class="record-description">학습 내용 기록</span></span><span class="site-link-arrow" aria-hidden="true">→</span></a>
      <a href="/about/1-day-1-commit/" class="site-link record-link"><span><span class="site-link-title">1일 1커밋</span><span class="record-description">꾸준히 기록해 온 경험</span></span><span class="site-link-arrow" aria-hidden="true">→</span></a>
    </div></section>
  </main>
</PageLayout>
<script>
  import { initializeStats } from '../../scripts/about-stats';
  initializeStats();
</script>
<style>
  .about-profile { padding-block: 2.75rem 2rem; }
  .about-profile .profile-avatar { width: 9.375rem; height: 9.375rem; border-radius: 1.4rem; }
  .profile-tagline { color: var(--color-text-muted); font-size: .9rem; margin: 1rem 0 0; }
  .profile-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.15rem; font-size: .82rem; }
  .profile-links a { color: var(--color-accent-light); text-decoration: none; }
  .profile-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .about-section { padding-block: 1.5rem; border-top: 1px solid var(--color-border); }
  .about-section h2 { margin: 0 0 1rem; font-size: 1.15rem; font-weight: 620; }
  .skills { display: flex; flex-wrap: wrap; gap: .55rem; list-style: none; padding: 0; margin: 0; }
  .skills li { padding: .3rem .8rem; border: 1px solid var(--color-border); border-radius: 4px; font-size: .82rem; }
  .stats-grid { display: grid; grid-template-columns: 1.233fr 1fr; gap: 1.15rem; align-items: start; }
  .stats-item { min-width: 0; }
  .stats-item img { display: block; width: 100%; height: auto; border-radius: 6px; }
  .record-links { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .record-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem .85rem; margin-inline: -.85rem; }
  .record-description { display: block; color: var(--color-text-muted); font-size: .8rem; margin-top: .25rem; }
  @media (max-width: 40rem) { .about-profile .profile-avatar { width: 5rem; height: 5rem; border-radius: .8rem; } .stats-grid, .record-links { grid-template-columns: 1fr; } .record-links { gap: .4rem; } }
</style>
