---
import DocsNavigation from './DocsNavigation.astro';
import Default from '@astrojs/starlight/components/Sidebar.astro';
import MobileMenuFooter from './MobileMenuFooter.astro';

const isBlog = Astro.url.pathname.startsWith('/blog');
const isAbout = Astro.url.pathname.startsWith('/about');
const hideSidebar = isAbout;
const isDocs = !isBlog && !hideSidebar;
const isDocsRoute = Astro.url.pathname.startsWith('/docs/');
---

{hideSidebar && (
  <style is:inline>
    nav.sidebar { display: none !important; }
    .main-frame { padding-inline-start: 0 !important; }
  </style>
)}

{isBlog && (
  <div class="md:sl-hidden">
    <MobileMenuFooter />
  </div>
)}

{isDocs && (isDocsRoute ? <><DocsNavigation /><div class="md:sl-hidden"><MobileMenuFooter /></div></> : <Default {...Astro.props} />)}
