---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import BlogContent from 'starlight-blog/components/MarkdownContent.astro';
import BlogArchive from './BlogArchive.astro';
import { isBlogArchive } from '../lib/blog';
const listing = isBlogArchive(Astro.url.pathname);
const isBlogPost = Astro.locals.starlightRoute.entry.id.startsWith('blog/') && Boolean(Astro.locals.starlightRoute.entry.data.date);
---
{listing ? <Default><BlogArchive /></Default> : isBlogPost ? <BlogContent><slot /></BlogContent> : <Default><slot /></Default>}
