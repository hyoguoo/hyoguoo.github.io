---
import type { StarlightBlogAuthor } from 'starlight-blog/schema';

interface Props {
  date?: Date;
  lastUpdated?: Date;
  authors?: StarlightBlogAuthor[];
}

const { date, lastUpdated, authors = [] } = Astro.props;
const displayDate = (value: Date) => value.toISOString().slice(0, 10).replaceAll('-', '.');
const modified = lastUpdated && date && lastUpdated.getTime() !== date.getTime() ? lastUpdated : undefined;
---

{(date || authors.length > 0) && (
  <div class="metadata compact not-content">
    {date && <div class="dates">
      <time datetime={date.toISOString()}>작성 {displayDate(date)}</time>
      {modified && <time datetime={modified.toISOString()}>수정 {displayDate(modified)}</time>}
    </div>}
    {authors.length > 0 && <div class="authors">
      {authors.map(author => author.url
        ? <a class="author" href={author.url}>{author.name}</a>
        : <span class="author">{author.name}</span>)}
    </div>}
  </div>
)}

<style>
  .metadata { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1rem; color: var(--t-text-muted); font-size: .8125rem; }
  .dates, .authors { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  .authors { gap: .5rem; }
  .author { color: inherit; text-decoration: none; }
  a.author:hover { color: var(--sl-color-text-accent); text-decoration: underline; }
</style>
