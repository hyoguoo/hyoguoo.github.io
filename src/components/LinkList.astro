---
interface Props {
  items: { title: string; url: string | null; hue?: number; description?: string; detail?: string; outline?: string }[];
  label?: string;
  compact?: boolean;
}
const { items, label, compact = false } = Astro.props;
---
{label && <h2 class="list-label">{label}<small>{items.length}개</small></h2>}
<ul class:list={['link-list', { compact }]}>
  {items.map(item => <li>
    {item.url ? <a href={item.url} class="site-link link-row">
      <span class="link-heading"><span class:list={['site-link-title', { 'topic-title': item.hue !== undefined }]} style={item.hue !== undefined ? `--item-hue:${item.hue}` : undefined}>{item.title}</span><span class="link-detail">{item.detail && <small>{item.detail}</small>}<span class="site-link-arrow" aria-hidden="true">→</span></span></span>
      {item.description && <span class="link-description">{item.description}</span>}
      {item.outline && <span class="link-outline">{item.outline}</span>}
    </a> : <span class="link-row link-row--disabled">{item.title}</span>}
  </li>)}
</ul>
<style>
  .list-label { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; font-size: 1rem; font-weight: 600; line-height: 1.65; color: var(--sl-color-text); margin: 0 0 .55rem; padding-bottom: .6rem; border-bottom: 1px solid var(--sl-color-hairline); }
  .list-label small { font-size: .7rem; font-weight: 400; color: var(--sl-color-gray-3); }
  .link-list { list-style: none; margin: 0; padding: 0; }
  .link-list li { margin: 0; padding: .15rem 0; }
  .link-row { display: block; padding: .75rem .85rem; color: var(--sl-color-text); font-size: 1rem; line-height: 1.65; }
  .link-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; font-weight: 580; }
  .link-description { display: block; color: var(--sl-color-gray-3); font-size: .82rem; font-weight: 400; line-height: 1.85; margin-top: .4rem; }
  .link-outline { display: block; color: var(--sl-color-gray-3); font-size: .72rem; font-weight: 400; line-height: 1.8; margin-top: .35rem; }
  .link-detail { display: inline-flex; align-items: center; gap: .8rem; flex-shrink: 0; color: var(--sl-color-gray-3); }
  .link-detail small { font-size: .7rem; font-weight: 400; }
  .topic-title { display: inline-flex; align-items: baseline; gap: .55rem; }
  .topic-title::before { content: ''; height: 5px; width: 5px; flex-shrink: 0; border-radius: 50%; background: light-dark(hsl(var(--item-hue) 45% 48%),hsl(var(--item-hue) 45% 65%)); }
  .link-row--disabled { color: var(--sl-color-gray-3); }
  .compact .link-row { padding-block: .4rem; }
  @media (max-width: 40rem) { .link-row { font-size: .92rem; padding-inline: .6rem; } .link-heading { gap: .7rem; } .link-detail { gap: .5rem; } }
</style>
