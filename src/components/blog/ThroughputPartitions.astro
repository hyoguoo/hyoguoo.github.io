---
const lanes = [
  { name: '파티션 0', thread: '스레드 1', orders: ['주문 A 결과', '주문 D 결과', '주문 A 결과(재전송)'] },
  { name: '파티션 1', thread: '스레드 2', orders: ['주문 B 결과', '주문 E 결과'] },
  { name: '파티션 2', thread: '스레드 3', orders: ['주문 C 결과', '주문 F 결과'] },
];
---
<figure class="pt-partition-figure" aria-labelledby="pt-partition-title" aria-describedby="pt-partition-caption">
  <div class="figure-heading" id="pt-partition-title">결과 메시지를 파티션 3개에 나눠 받는 구조</div>
  <div class="lanes">
    {lanes.map(lane => (
      <section class="lane" aria-label={`${lane.name}을 ${lane.thread}가 순서대로 처리`}>
        <span class="lane-name">{lane.name}</span>
        <ol class="messages">
          {lane.orders.map(order => <li class:list={{ same: order.startsWith('주문 A') }}>{order}</li>)}
        </ol>
        <span class="arrow" aria-hidden="true">→</span>
        <span class="thread">{lane.thread}</span>
      </section>
    ))}
  </div>
  <figcaption id="pt-partition-caption">주문 A의 메시지는 모두 파티션 0으로 들어가 스레드 1이 순서대로 처리한다.</figcaption>
</figure>
<style>
  .pt-partition-figure { --same: #286596; margin: 1.75rem 0; padding: 1.25rem 0; border-block: 1px solid var(--sl-color-hairline); color: var(--sl-color-text); }
  :global([data-theme='dark']) .pt-partition-figure { --same: #8abde7; }
  .pt-partition-figure :is(div, p, section, ol, li, i) { margin-block: 0; }
  .figure-heading { font-size: 0.95rem; font-weight: 600; color: var(--sl-color-white); }
  .lanes { display: grid; gap: 0.6rem; margin-top: 1rem !important; }
  .lane { display: grid; grid-template-columns: 4.5rem 1fr auto 3.8rem; align-items: center; gap: 0.6rem; font-size: 0.78rem; }
  .lane-name { font-weight: 600; color: var(--sl-color-white); }
  .messages { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; padding: 0.35rem; margin: 0; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); }
  .messages li { padding: 0.1rem 0.45rem; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg); white-space: nowrap; }
  .messages li.same { border-color: var(--same); color: var(--same); }
  .arrow { color: var(--sl-color-gray-2); }
  .thread { padding: 0.15rem 0.4rem; border: 1px solid var(--sl-color-text-accent); color: var(--sl-color-white); text-align: center; }
  figcaption { margin-top: 1rem; font-size: 0.78rem; line-height: 1.7; }
  @media (max-width: 40rem) {
    .lane { grid-template-columns: 1fr auto; }
    .lane-name { grid-column: 1 / -1; }
    .arrow { display: none; }
    .messages { grid-column: 1; }
  }
</style>
