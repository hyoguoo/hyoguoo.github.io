---
const maximum = 180;
const groups = [
  {
    title: '서버 처리량 테스트',
    rate: 140,
    rows: [
      { label: '스레드 1개', value: 106.7, status: '적체 누적', ok: false },
      { label: '스레드 3개', value: 139.7, status: '안정 처리', ok: true },
    ],
  },
  {
    title: '서버 처리량 테스트',
    rate: 160,
    rows: [
      { label: '스레드 1개', value: 102.3, status: '적체 누적', ok: false },
      { label: '스레드 3개', value: 141.6, status: '적체 누적', ok: false },
    ],
  },
  {
    title: '사용자 화면 테스트',
    rate: 100,
    rows: [
      { label: '스레드 1개', value: 20.4, status: '목표 미달', ok: false },
      { label: '스레드 3개', value: 99.8, status: '목표 통과', ok: true },
    ],
  },
];
const percent = (value: number) => `${value / maximum * 100}%`;
---
<figure class="pt-thread-figure" aria-labelledby="pt-thread-title">
  <div class="figure-heading" id="pt-thread-title">결과 반영 스레드 1개 → 3개, 부하 중 결제 완료(건/초)</div>
  <p class="scale-note">모든 막대에 같은 0~180 축 적용 · 점선은 보낸 요청 속도</p>
  <div class="groups">
    {groups.map(group => (
      <section class="group" aria-label={`${group.title}, 초당 ${group.rate}건 요청`}>
        <div class="group-heading"><span class="group-title">{group.title}</span><span class="rate">초당 {group.rate}건 요청</span></div>
        {group.rows.map(row => (
          <div class:list={['row', row.ok ? 'ok' : 'ng', { after: row.label === '스레드 3개' }]} aria-label={`${row.label}: 초당 ${row.value}건, ${row.status}`}>
            <span class="label">{row.label}</span>
            <div class="track" aria-hidden="true">
              <div class="bar" style={`width: ${percent(row.value)}`}></div>
              <i class="target" style={`left: ${percent(group.rate)}`}></i>
            </div>
            <span class="value">{row.value}</span>
            <span class="status">{row.status}</span>
          </div>
        ))}
      </section>
    ))}
  </div>
</figure>
<style>
  .pt-thread-figure { --warn: #a44235; --good: #286596; margin: 1.75rem 0; padding: 1.25rem 0; border-block: 1px solid var(--sl-color-hairline); color: var(--sl-color-text); }
  :global([data-theme='dark']) .pt-thread-figure { --warn: #eea397; --good: #8abde7; }
  .pt-thread-figure :is(div, p, section, ol, li, i) { margin-block: 0; }
  .figure-heading { font-size: 0.95rem; font-weight: 600; color: var(--sl-color-white); }
  .scale-note { margin-top: 0.45rem !important; font-size: 0.78rem; line-height: 1.7; }
  .groups { display: grid; gap: 1.2rem; margin-top: 1rem !important; }
  .group { display: grid; gap: 0.35rem; }
  .group-heading { display: flex; align-items: baseline; gap: 0.6rem; font-size: 0.8rem; }
  .group-title { font-weight: 600; color: var(--sl-color-white); }
  .rate { font-size: 0.74rem; color: var(--sl-color-gray-2); }
  .row { display: grid; grid-template-columns: 4.6rem 1fr 3rem 4.6rem; align-items: center; gap: 0.6rem; font-size: 0.78rem; }
  .label { color: var(--sl-color-gray-2); }
  .track { position: relative; height: 0.85rem; background: var(--sl-color-bg-nav); }
  .bar { height: 100%; background: var(--sl-color-gray-3); }
  .after .bar { background: var(--sl-color-text-accent); }
  .target { position: absolute; top: -0.25rem; bottom: -0.25rem; border-left: 1px dashed var(--sl-color-white); }
  .value { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--sl-color-white); text-align: right; }
  .status { font-size: 0.72rem; font-weight: 600; text-align: center; padding: 0.05rem 0.3rem; border: 1px solid currentColor; border-radius: 0.25rem; }
  .ok .status { color: var(--good); }
  .ng .status { color: var(--warn); }
  @media (max-width: 40rem) {
    .row { grid-template-columns: 4.2rem 1fr 2.6rem; }
    .status { grid-column: 2 / -1; justify-self: start; }
  }
</style>
