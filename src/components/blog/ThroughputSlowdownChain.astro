---
const steps = [
  { title: '승인 결과 도착', value: '초당 140건', detail: '요청 140건마다 승인 결과 메시지가 하나씩 온다' },
  { title: '결과 반영 스레드 1개', value: '최대 초당 약 120건', detail: '한 건씩 처리, 부하 중 건당 약 8ms', bottleneck: true },
  { title: '처리하지 못한 메시지', value: '초당 약 30건씩 증가', detail: '결과 반영 앞에 쌓인다' },
  { title: '부하 중 결제 완료', value: '초당 106.7건', detail: '요청보다 적게 처리해 밀린 결제가 계속 늘어난다' },
];
---
<figure class="pt-chain-figure" aria-labelledby="pt-chain-title">
  <div class="figure-heading" id="pt-chain-title">초당 140건 요청에서 병목이 생기는 위치</div>
  <ol class="chain">
    {steps.map((step, index) => (
      <li class:list={['step', { bottleneck: step.bottleneck }]}>
        <span class="head">
          <span class="number" aria-hidden="true">{index + 1}</span>
          {step.bottleneck && <span class="badge">병목</span>}
        </span>
        <span class="title">{step.title}</span>
        <span class="value">{step.value}</span>
        <span class="detail">{step.detail}</span>
      </li>
    ))}
  </ol>
</figure>
<style>
  .pt-chain-figure { --warn: #a44235; --warn-bg: rgba(164, 66, 53, 0.08); margin: 1.75rem 0; padding: 1.25rem 0; border-block: 1px solid var(--sl-color-hairline); color: var(--sl-color-text); }
  :global([data-theme='dark']) .pt-chain-figure { --warn: #eea397; --warn-bg: rgba(238, 163, 151, 0.1); }
  .pt-chain-figure :is(div, p, section, ol, li, i) { margin-block: 0; }
  .figure-heading { font-size: 0.95rem; font-weight: 600; color: var(--sl-color-white); }
  .chain { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.4rem; list-style: none; padding: 0; margin-top: 1rem !important; }
  .step { position: relative; display: flex; flex-direction: column; gap: 0.25rem; padding: 0.7rem; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); }
  .step:not(:last-child)::after { content: '→'; position: absolute; right: -1.1rem; top: 50%; transform: translateY(-50%); color: var(--sl-color-gray-2); }
  .step.bottleneck { border: 2px solid var(--warn); background: var(--warn-bg); }
  .head { display: flex; align-items: center; justify-content: space-between; }
  .number { font-size: 0.68rem; color: var(--sl-color-gray-2); }
  .badge { font-size: 0.65rem; font-weight: 600; color: var(--warn); border: 1px solid var(--warn); border-radius: 0.25rem; padding: 0 0.3rem; }
  .title { font-size: 0.84rem; font-weight: 600; color: var(--sl-color-white); }
  .value { font-size: 0.88rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--sl-color-text-accent); }
  .bottleneck .value { color: var(--warn); }
  .detail { font-size: 0.72rem; line-height: 1.5; }
  @media (max-width: 50rem) {
    .chain { grid-template-columns: 1fr; gap: 1rem; }
    .step:not(:last-child)::after { content: '↓'; right: auto; left: 1rem; top: auto; bottom: -1.05rem; transform: none; }
  }
</style>
