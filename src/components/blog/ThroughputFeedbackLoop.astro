---
const steps = [
  { title: '결과 반영이 밀린다', detail: '건당 처리 시간 약 7~10ms → 34~68ms' },
  { title: '완료되지 않은 주문이 늘어난다', detail: '부하 3분 동안 밀린 결제가 계속 늘어난다' },
  { title: '상태 조회가 계속 늘어난다', detail: '완료될 때까지 주문마다 1초 간격으로 조회한다' },
  { title: 'DB 커넥션을 두고 경쟁한다', detail: '조회와 결과 반영이 같은 DB 커넥션을 나눠 쓴다' },
];
---
<figure class="pt-loop-figure" aria-labelledby="pt-loop-title">
  <div class="figure-heading" id="pt-loop-title">결과 반영 지연과 상태 조회의 악순환</div>
  <div class="cycle">
    <ol class="loop">
      {steps.map((step, index) => (
        <li class={`step step-${index + 1}`}>
          <span class="number" aria-hidden="true">{index + 1}</span>
          <div>
            <span class="title">{step.title}</span>
            <span class="detail">{step.detail}</span>
          </div>
        </li>
      ))}
    </ol>
    <span class="center" aria-hidden="true">↻<b>반복</b></span>
  </div>
</figure>
<style>
  .pt-loop-figure { --warn: #a44235; --warn-bg: rgba(164, 66, 53, 0.08); margin: 1.75rem 0; padding: 1.25rem 0; border-block: 1px solid var(--sl-color-hairline); color: var(--sl-color-text); }
  :global([data-theme='dark']) .pt-loop-figure { --warn: #eea397; --warn-bg: rgba(238, 163, 151, 0.1); }
  .pt-loop-figure :is(div, p, section, ol, li, i) { margin-block: 0; }
  .figure-heading { font-size: 0.95rem; font-weight: 600; color: var(--sl-color-white); }
  .cycle { position: relative; margin-top: 1rem !important; }
  .loop { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 3rem; list-style: none; padding: 0; margin: 0; }
  .step { position: relative; display: flex; gap: 0.6rem; padding: 0.75rem; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); }
  .step-1 { grid-column: 1; grid-row: 1; border-color: var(--warn); background: var(--warn-bg); }
  .step-2 { grid-column: 2; grid-row: 1; }
  .step-3 { grid-column: 2; grid-row: 2; }
  .step-4 { grid-column: 1; grid-row: 2; }
  .step::after { position: absolute; color: var(--warn); font-size: 1rem; }
  .step-1::after { content: '→'; right: -2rem; top: 50%; transform: translateY(-50%); }
  .step-2::after { content: '↓'; left: 50%; bottom: -1.45rem; }
  .step-3::after { content: '←'; left: -2rem; top: 50%; transform: translateY(-50%); }
  .step-4::after { content: '↑'; left: 50%; top: -1.45rem; }
  .number { display: flex; justify-content: center; align-items: center; flex-shrink: 0; width: 1.3rem; height: 1.3rem; border: 1px solid var(--sl-color-hairline); border-radius: 50%; font-size: 0.7rem; }
  .title, .detail { display: block; }
  .title { font-size: 0.86rem; font-weight: 600; color: var(--sl-color-white); }
  .detail { margin-top: 0.2rem; font-size: 0.74rem; line-height: 1.6; }
  .step-1 .detail { color: var(--warn); font-weight: 600; }
  .center { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; justify-content: center; width: 3.2rem; height: 3.2rem; border: 1px solid var(--warn); border-radius: 50%; background: var(--sl-color-bg); color: var(--warn); font-size: 1rem; line-height: 1; }
  .center b { margin-top: 0.15rem; font-size: 0.66rem; }
  @media (max-width: 40rem) {
    .loop { grid-template-columns: 1fr; gap: 1.2rem; }
    .step-1, .step-2, .step-3, .step-4 { grid-column: 1; grid-row: auto; }
    .step::after { content: '↓' !important; left: 1.2rem !important; right: auto !important; top: auto !important; bottom: -1.2rem !important; transform: none !important; }
    .step-4::after { content: '↻ 1로 반복' !important; font-size: 0.72rem; }
    .center { display: none; }
  }
</style>
