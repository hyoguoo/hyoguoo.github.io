---
import { getCollection } from 'astro:content';
import { isBlogArchive } from '../lib/blog';
import EntryMeta from './EntryMeta.astro';
import BlogSeries from './BlogSeries.astro';
import { BLOG_CONFIG as config } from '../data/blogConfig';
import { titleHtml } from '../lib/metadata';
import { DOCS_GROUPS } from '../data/docsGroups';
import type { StarlightBlogAuthor } from 'starlight-blog/schema';

const { entry } = Astro.locals.starlightRoute;

// Individual blog post: id starts with 'blog/' and has a date
const isBlogPost = entry?.id?.startsWith('blog/') && !!entry?.data?.date;
// Docs page: id starts with 'docs/'
const isDocsPage = entry.id === 'docs' || entry.id.startsWith('docs/');
const isDocsIndex = isDocsPage && !entry.data.date;
const isDocsPost = isDocsPage && Boolean(entry.data.date);
const topic = DOCS_GROUPS.flatMap(group => group.items).find(item => item.key === entry.id.split('/')[1]);
const showMeta = isBlogPost || (isDocsPage && Boolean(entry.data.date));
const docCount = isDocsIndex ? (await getCollection('docs', ({ id, data }) => id.startsWith(`${entry.id}/`) && !data.draft && Boolean(data.date))).length : undefined;

const configuredAuthors: Record<string, StarlightBlogAuthor> = config.authors;

function resolveAuthors(entry: typeof Astro.locals.starlightRoute.entry): StarlightBlogAuthor[] {
  const rawAuthors = entry?.data?.authors;
  if (!rawAuthors) {
    return Object.values(config.authors);
  }
  if (typeof rawAuthors === 'string') {
    const found = configuredAuthors[rawAuthors];
    return found ? [found] : [{ name: rawAuthors }];
  }
  if (Array.isArray(rawAuthors)) {
    return rawAuthors.map((a: string | StarlightBlogAuthor) =>
      typeof a === 'string' ? (configuredAuthors[a] ?? { name: a }) : a
    );
  }
  return [rawAuthors as StarlightBlogAuthor];
}

const date: Date | undefined = showMeta ? entry?.data?.date : undefined;
const lastUpdated: Date | undefined =
  showMeta &&
  entry?.data?.lastUpdated &&
  typeof entry.data.lastUpdated !== 'boolean'
    ? entry.data.lastUpdated
    : undefined;
const authors: StarlightBlogAuthor[] = showMeta ? resolveAuthors(entry) : [];

// Convert backtick-wrapped text to <code> for inline code in titles
const rawTitle = entry?.data?.title ?? '';
const renderedTitle = titleHtml(rawTitle);

// Back to parent button
const pathname = Astro.url.pathname;
const pathParts = pathname.replace(/\/$/, '').split('/').filter(Boolean);
const showBackButton = isBlogPost || (isDocsPage && pathParts.length >= 2);
const parentPath = showBackButton
  ? (isBlogPost ? '/blog/' : '/' + pathParts.slice(0, -1).join('/') + '/')
  : null;
const parentName = parentPath
  ? (isBlogPost ? 'Blog' : parentPath
      .replace(/\/$/, '')
      .split('/')
      .pop()!
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase()))
  : null;
---

{isDocsPost && topic ? (
  <nav class="article-path" aria-label="문서 경로">
    <a href="/docs/">Docs</a><span aria-hidden="true">/</span>
    <a href={`/docs/${topic.key}/`}>{topic.label}</a>
    {pathParts.length > 3 && parentPath && <>
      <span aria-hidden="true">/</span><a href={parentPath}>{parentName}</a>
    </>}
  </nav>
) : showBackButton && parentPath && (
  <div class="back-link">
    <a href={parentPath}><span aria-hidden="true">←</span> {parentName}</a>
  </div>
)}
<h1 id="_top" class:list={{ 'collection-title': isDocsIndex || isBlogArchive(Astro.url.pathname) }}><span set:html={renderedTitle} />{docCount !== undefined && <small class="doc-count">{docCount}개 문서</small>}</h1>
{isDocsIndex && entry.data.description && <p class="index-description">{entry.data.description}</p>}
{showMeta && <EntryMeta {date} {lastUpdated} {authors} />}
{isBlogPost && <BlogSeries currentId={entry?.id ?? ''} />}

<style>
  .article-path { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; font-size: .75rem; color: var(--sl-color-gray-3); margin-bottom: 1.1rem; }
  .article-path a { color: inherit; text-decoration: none; }
  .article-path a:hover { color: var(--sl-color-text-accent); }
  .article-path + h1 { margin-top: 0; }
  h1 + :global(.metadata) { margin-top: .9rem; }
  h1.collection-title { font-size: 2rem; line-height: 1.35; margin-top: 0; }
  .doc-count { margin-left: .75rem; color: var(--sl-color-gray-3); font-size: .85rem; font-weight: 400; white-space: nowrap; }
  .index-description { color: var(--sl-color-gray-3); font-size: .85rem; line-height: 1.85; margin-top: .75rem; }
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }

  h1 :global(code) {
    font-size: 0.9em;
    background-color: var(--sl-color-bg-inline-code);
    border-radius: 0.25rem;
    padding: 0.1em 0.3em;
  }

  .back-link {
    margin-bottom: 0.5rem;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text-accent);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  .back-link a:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
