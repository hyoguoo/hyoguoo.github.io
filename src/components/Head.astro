---
import Analytics from './Analytics.astro';
import { contentDate, isDocsArticle } from '../lib/content';
import { jsonLd } from '../lib/metadata';
import Default from '@astrojs/starlight/components/Head.astro';

const SITE_URL = 'https://hyoguoo.github.io';
const AUTHOR_NAME = 'hyoguoo';
const AUTHOR_URL = 'https://github.com/hyoguoo';
const DEFAULT_OG_IMAGE = `${SITE_URL}/og.png`;

const route = Astro.locals.starlightRoute;
const entry = route.entry;
const data = entry.data;
const id: string = entry.id;

const isBlog = id.startsWith('blog/') && !id.endsWith('/index');
const isDocs = isDocsArticle(id);
const isArticle = (isBlog || isDocs) && Boolean(data?.date);

const published = contentDate(data.date)?.toISOString();
const modified = contentDate(data.lastUpdated)?.toISOString() ?? published;
const tags: string[] = Array.isArray(data?.tags) ? data.tags : [];

const is404 = id === '404' || id === '404.html';
const pageUrl = new URL(is404 ? '/404.html' : Astro.url.pathname, SITE_URL).toString();
if (is404) {
  for (const item of route.head) {
    if (item.tag === 'link' && item.attrs?.rel === 'canonical') item.attrs.href = pageUrl;
    if (item.tag === 'meta' && item.attrs?.property === 'og:url') item.attrs.content = pageUrl;
  }
}

const articleSchema = isArticle
	? {
			'@context': 'https://schema.org',
			'@type': isBlog ? 'BlogPosting' : 'TechArticle',
			headline: data.title,
			description: data.description,
			datePublished: published,
			dateModified: modified,
			author: {
				'@type': 'Person',
				name: AUTHOR_NAME,
				url: AUTHOR_URL,
			},
			publisher: {
				'@type': 'Person',
				name: AUTHOR_NAME,
				url: SITE_URL,
			},
			mainEntityOfPage: {
				'@type': 'WebPage',
				'@id': pageUrl,
			},
			image: DEFAULT_OG_IMAGE,
			inLanguage: 'ko',
			keywords: tags.length > 0 ? tags.join(', ') : undefined,
	  }
	: null;

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
	{ name: 'Home', url: `${SITE_URL}/` },
	...segments.map((seg, i) => ({
		name: i === segments.length - 1 && data?.title ? data.title : seg,
		url: `${SITE_URL}/${segments.slice(0, i + 1).join('/')}/`,
	})),
];
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbItems.map((b, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: b.name,
		item: b.url,
	})),
};
---

<Default />
<Analytics />
<script is:inline>
  if (location.pathname === '/blog/' || location.pathname.startsWith('/blog/')) {
    document.documentElement.setAttribute('data-no-sidebar', '');
    document.documentElement.removeAttribute('data-has-sidebar');
    if (location.pathname === '/blog/') document.documentElement.setAttribute('data-blog-index', '');
  }
</script>
<script>
  import { initializeTheme } from '../scripts/theme';
  import { initializeMermaid } from '../scripts/mermaid';
  initializeTheme();
  initializeMermaid().catch(error => console.error('Mermaid initialization failed:', error));
</script>
{isArticle && published && <meta property="article:published_time" content={published} />}
{isArticle && modified && <meta property="article:modified_time" content={modified} />}
{isArticle && <meta property="article:author" content={AUTHOR_NAME} />}
{isArticle && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{articleSchema && (
	<script type="application/ld+json" set:html={jsonLd(articleSchema)} />
)}
<script type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />