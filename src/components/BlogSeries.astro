---
import { Icon } from '@astrojs/starlight/components';
import { BLOG_SERIES } from '../data/blogSeries';

interface Props { currentId: string }
const { currentId } = Astro.props;
const series = Object.values(BLOG_SERIES).find(series => series.posts.some(post => post.id === currentId));
const currentIndex = series?.posts.findIndex(post => post.id === currentId) ?? -1;
---

{series && <details class="series-block not-content">
  <summary>
    <span class="series-label">시리즈</span>
    <span class="series-title">{series.title}</span>
    <span class="series-position" aria-label={`${series.posts.length}편 중 ${currentIndex + 1}번째 글`}>{currentIndex + 1} / {series.posts.length}</span>
    <Icon name="right-caret" size="1rem" class="caret" />
  </summary>
  <ol class="series-list">
    {series.posts.map((post, index) => <li class:list={{ 'is-current': post.id === currentId }}>
      <span class="item-number" aria-hidden="true">{index + 1}</span>
      {post.id === currentId ? <span class="current-title" aria-current="page">{post.title}<small>현재 글</small></span> : <a href={`/${post.id}/`}>{post.title}</a>}
    </li>)}
  </ol>
</details>}

<style>
  .series-block { margin-top: 1.6rem; border: 1px solid var(--sl-color-hairline); border-radius: 8px; }
  summary { display: flex; align-items: center; gap: .75rem; padding: .9rem 1rem; cursor: pointer; list-style: none; border-radius: inherit; transition: background-color 180ms ease-out; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--sl-color-gray-6); }
  summary:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .series-label, .series-position { font-size: .75rem; color: var(--sl-color-gray-3); white-space: nowrap; }
  .series-title { flex: 1; font-size: .85rem; font-weight: 500; }
  .caret { flex-shrink: 0; color: var(--sl-color-gray-3); transition: transform 180ms ease-out; }
  details[open] .caret { transform: rotate(90deg); }
  .series-list { list-style: none; padding: .5rem .6rem .75rem; margin: 0; border-top: 1px solid var(--sl-color-hairline); }
  li { display: flex; align-items: baseline; gap: .65rem; padding: .45rem .5rem; font-size: .8rem; line-height: 1.6; border-radius: 4px; }
  .item-number { flex: 0 0 1.25rem; color: var(--sl-color-gray-3); font-size: .7rem; text-align: right; font-variant-numeric: tabular-nums; }
  a { color: var(--sl-color-text); text-decoration: none; }
  a:hover { color: var(--sl-color-text-accent); text-decoration: underline; }
  .is-current { background: color-mix(in srgb, var(--sl-color-text-accent) 9%, transparent); color: var(--sl-color-text-accent); }
  small { display: inline-block; margin-left: .6rem; font-size: .7rem; color: var(--sl-color-gray-3); white-space: nowrap; }
  @media (max-width: 30rem) { summary { gap: .5rem; padding: .8rem; } .series-label { display: none; } }
  @media (prefers-reduced-motion: reduce) { summary, .caret { transition: none; } }
</style>
