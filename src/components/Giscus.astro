---
// Giscus comment component — GitHub Discussions based.
// Configuration (repo IDs) lives in src/data/giscusConfig.ts.
import { repo, repoId, category, categoryId } from '../data/giscusConfig';
---

<div class="giscus-wrapper">
  <div id="giscus-container" data-repo={repo} data-repo-id={repoId} data-category={category} data-category-id={categoryId}></div>
</div>

<script>
  import { initializeGiscus } from '../scripts/giscus';
  initializeGiscus();
</script>

<style>
  .giscus-wrapper {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
</style>
