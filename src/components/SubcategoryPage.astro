---
import { groupDocs } from '../lib/docs';
import { getCollection } from 'astro:content';
import { docsSections } from '../data/docsSections';
import LinkList from './LinkList.astro';

interface Props {
  subcategory: string;
}

const { subcategory } = Astro.props;

const allDocs = await getCollection('docs', ({ id, data }) => {
  const parts = id.split('/');
  const last = parts[parts.length - 1];
  // 직접 자식 depth만 포함 (docs/<subcategory>/<slug>)
  // 더 깊은 경로(예: docs/java/effective-java/item1)는 제외
  return (
    !data.draft && id.startsWith(`docs/${subcategory}/`) &&
    parts.length === 3 &&
    !['index', 'index.md', 'index.mdx'].includes(last)
  );
});

const grouped = groupDocs(allDocs, subcategory, docsSections[subcategory]);

---

<div class="subcategory-page">
  {grouped.map(({ label, docs }) => (
    <section class="doc-section"><LinkList
      label={label || undefined}
      items={docs.map(doc => ({ title: doc.title, url: doc.url, description: doc.description }))}
    /></section>
  ))}
</div>

<style>
  .subcategory-page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 0.25rem 0;
  }
</style>
