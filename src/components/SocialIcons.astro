---
const pathname = Astro.url.pathname;
const links = [{href:'/',label:'Home'},{href:'/blog/',label:'Blog'},{href:'/docs/',label:'Docs'},{href:'/about/',label:'About'}];
---
<nav class="site-nav site-navigation" aria-label="주요 페이지">
  {links.map(link => <a href={link.href} aria-current={pathname === link.href ? 'page' : link.href !== '/' && pathname.startsWith(link.href) ? 'location' : undefined}>{link.label}</a>)}
</nav>
<style>
  .site-nav { display: flex; align-items: center; gap: 1.4rem; }
  a { position: relative; padding-block: .45rem; color: var(--t-text-muted); font-size: .8rem; font-weight: 450; line-height: 1.5; text-decoration: none; }
  a:hover { color: var(--t-text); text-decoration: none; }
  a[aria-current] { color: var(--t-text); font-weight: 550; }
  a[aria-current]::after { content: ''; position: absolute; inset-inline: 0; bottom: -.05rem; height: 1px; background: var(--t-accent-light); }
  @media (max-width: 49.999rem) { .site-nav { justify-content: space-between; width: 100%; gap: 1rem; } a { min-height: 2.75rem; display: inline-flex; align-items: center; } }
</style>
