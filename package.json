{
  "name": "hyoguoo-notes",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --minimumFailingSeverity hint",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "validate": "npm run check && npm test && npm run build && npm run test:browser",
    "audit:links": "node scripts/audit-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.12",
    "mermaid": "^12.3.0",
    "sharp": "^0.35.5",
    "starlight-blog": "^0.30.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
